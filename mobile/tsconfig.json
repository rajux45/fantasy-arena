{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@fantasy-arena/shared": ["../packages/shared/src/index.ts"],
      "@fantasy-arena/shared/*": ["../packages/shared/src/*"]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx", "app.config.ts"]
}
