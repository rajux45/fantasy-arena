ENV=development
APP_NAME=fantasy-arena
SECRET_KEY=change-me-32-bytes-random-please-generate
ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14

DATABASE_URL=postgresql+psycopg://fantasy:fantasy@localhost:5432/fantasy_arena
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Encryption (used to encrypt PII columns) — Fernet key, base64 32-byte
PII_ENCRYPTION_KEY=

# Razorpay (sandbox)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OTP / SMS (MSG91 sandbox)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=FANTAS

# KYC (Digio sandbox)
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=
DIGIO_BASE_URL=https://ext.digio.in:444

# Sports data (Roanuz sandbox)
ROANUZ_PROJECT_KEY=
ROANUZ_API_KEY=

# Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@fantasy-arena.example

# Geo (MaxMind path; optional in dev)
GEOIP_DB_PATH=

# Sentry
SENTRY_DSN=

# Misc
RG_DAILY_DEPOSIT_LIMIT=2500000   # in paise (₹25,000)
WITHDRAWAL_MIN_PAISE=10000       # ₹100
WITHDRAWAL_MAX_PAISE=10000000    # ₹1,00,000
